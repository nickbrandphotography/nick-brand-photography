# ============================================================
# Nick Brand Photography — environment variables
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed.
# ============================================================

# --- Google Calendar (booking system) -----------------------
# From: Google Cloud Console → IAM & Admin → Service Accounts
# → your service account → Keys → the downloaded JSON key file

GOOGLE_SERVICE_ACCOUNT_EMAIL=nick-brand-photography@project-2a2660c4-79b4-472a-a3f.iam.gserviceaccount.com

# Copy the "private_key" field from the JSON key file.
# It starts with -----BEGIN PRIVATE KEY----- and ends with -----END PRIVATE KEY-----
# Paste it on one line with \n in place of real newlines (it will look like the line below).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Your Google Calendar ID — found in Google Calendar Settings → your calendar
# → scroll to "Calendar ID". Looks like an email address or long string.
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# --- Web3Forms (contact form) --------------------------------
# Free signup at web3forms.com using info@nickbrandphotography.com
WEB3FORMS_KEY=your-web3forms-access-key

# --- Google Business Profile (footer Reviews link) -----------
# Your Google Business Profile URL — activates the Reviews link in the footer.
# NEXT_PUBLIC_ prefix makes it available client-side.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://g.page/r/your-business-id/review

# --- Conversion tracking --------------------------------------
# Every one of these is independently optional — set only the ones you're
# using, in any combination. Nothing loads until its own var is set, so
# leaving one blank is a safe no-op, same as GA4 above.

# Google Analytics 4 measurement ID (Admin → Data Streams → your stream).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads account ID — the "AW-XXXXXXXXX" shown when you create a
# conversion action (Tools & Settings → Conversions). Loads the sitewide
# remarketing tag; shares the same gtag.js load as GA4 above.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# The label half of the "send_to" value Google Ads gives you for that same
# conversion action — the part after the slash, e.g. AW-XXXXXXXXX/AbC-D_efG
# means the label is AbC-D_efG. Fires on /book/confirmed only, for a real
# completed booking or enquiry — see lib/analytics.ts.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbC-D_efG

# Meta (Facebook/Instagram) Pixel ID — Events Manager → your pixel → Settings.
# Loads the sitewide base pixel (PageView, for retargeting audiences) plus a
# Lead/Schedule event on /book/confirmed.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
